<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dome_mission</name>
  <version>0.1.0</version>
  <description>
    Mission-sequencing layer for the DOME robot (F35). Owns /intent and drives
    a pure mission FSM that composes dome_nav primitives (ExploreArea action)
    and Nav2 NavigateToPose. Keeps dome_nav free of mission/semantic knowledge.
  </description>
  <maintainer email="pitosalas@gmail.com">pitosalas</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>dome_nav_msgs</depend>
  <depend>dome_semantic_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
